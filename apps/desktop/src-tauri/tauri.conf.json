{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rchat",
  "version": "0.1.2",
  "identifier": "network.rchat.desktop",
  "build": {
    "beforeDevCommand": "npm run build && node scripts/prepare-bundle.mjs",
    "beforeBuildCommand": "npm run build && node scripts/prepare-bundle.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk0MUZENjBCNTI5OEUyMzMKUldRejRwaFNDOVlmbExaUkNPTVE5WTQycUtsVDVaT2lLdWtnSDZJMmI0dVcyM2YxQW0rYU9yY2gK",
      "endpoints": [
        "https://github.com/bestusecase/rchat/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "category": "SocialNetworking",
    "shortDescription": "Messaging over Reticulum",
    "longDescription": "rchat is a fast, offline-first messenger for Reticulum. Direct messages, delivery receipts, search and an offline queue, with no central server.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": {
      "resources/rchatd": "rchatd",
      "runtime": "runtime",
      "../../../sidecar/bridge.py": "sidecar/bridge.py",
      "assets/chime.wav": "assets/chime.wav"
    },
    "linux": {
      "deb": {
        "depends": [],
        "files": {
          "/etc/apt/sources.list.d/rchat.list": "packaging/deb/rchat.list",
          "/usr/lib/rchat/rchat-update": "packaging/deb/rchat-update",
          "/usr/lib/systemd/system/rchat-update.service": "packaging/deb/rchat-update.service",
          "/usr/lib/systemd/system/rchat-update.timer": "packaging/deb/rchat-update.timer",
          "/usr/share/keyrings/rchat-archive-keyring.gpg": "packaging/deb/rchat-archive-keyring.gpg"
        },
        "postInstallScript": "packaging/deb/postinst",
        "preRemoveScript": "packaging/deb/prerm",
        "postRemoveScript": "packaging/deb/postrm"
      }
    }
  }
}
